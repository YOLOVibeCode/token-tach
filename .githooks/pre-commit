#!/usr/bin/env bash
# Pre-commit hook: block secrets from being committed

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'

# Patterns that indicate secrets
SECRET_PATTERNS=(
  'ANTHROPIC_API_KEY'
  'OPENAI_API_KEY'
  'CURSOR_API_KEY'
  'COPILOT_TOKEN'
  'CODEIUM_API_KEY'
  'sk-ant-'
  'sk-proj-'
  'sk-or-'
  'ghp_'
  'gho_'
  'ghu_'
  'ghs_'
  'github_pat_'
  'PRIVATE.KEY'
  'BEGIN RSA PRIVATE KEY'
  'BEGIN OPENSSH PRIVATE KEY'
  'BEGIN EC PRIVATE KEY'
  'BEGIN DSA PRIVATE KEY'
  'BEGIN PGP PRIVATE KEY'
  'password\s*[:=]\s*["\x27][^"\x27]'
  'secret\s*[:=]\s*["\x27][^"\x27]'
  'api_key\s*[:=]\s*["\x27][^"\x27]'
  'token\s*[:=]\s*["\x27][^"\x27]'
)

# File extensions that should never be committed
BLOCKED_EXTENSIONS=(
  '\.pem$'
  '\.key$'
  '\.p12$'
  '\.pfx$'
  '\.jks$'
  '\.keystore$'
  '\.keychain$'
  '\.keychain-db$'
)

# Files that should never be committed
BLOCKED_FILES=(
  '\.env$'
  '\.env\.'
  'credentials\.json$'
  'secrets\.json$'
  'service-account.*\.json$'
  'api_keys\.json$'
  'tokens\.json$'
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
FOUND_ISSUES=0

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check for blocked file names
for pattern in "${BLOCKED_FILES[@]}"; do
  MATCHES=$(echo "$STAGED_FILES" | grep -iE "$pattern" || true)
  if [ -n "$MATCHES" ]; then
    echo -e "${RED}BLOCKED:${NC} Secret/credential file staged for commit:"
    echo "$MATCHES"
    FOUND_ISSUES=1
  fi
done

# Check for blocked extensions
for pattern in "${BLOCKED_EXTENSIONS[@]}"; do
  MATCHES=$(echo "$STAGED_FILES" | grep -iE "$pattern" || true)
  if [ -n "$MATCHES" ]; then
    echo -e "${RED}BLOCKED:${NC} Sensitive file type staged for commit:"
    echo "$MATCHES"
    FOUND_ISSUES=1
  fi
done

# Check file contents for secret patterns (skip the hook itself)
for file in $STAGED_FILES; do
  if [ "$file" = ".githooks/pre-commit" ]; then
    continue
  fi
  if [ -f "$file" ] && file "$file" | grep -q "text"; then
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if git diff --cached -- "$file" | grep -qiE "\+.*$pattern"; then
        echo -e "${RED}BLOCKED:${NC} Potential secret found in $file (pattern: $pattern)"
        FOUND_ISSUES=1
      fi
    done
  fi
done

if [ $FOUND_ISSUES -ne 0 ]; then
  echo ""
  echo "Commit aborted. Remove secrets before committing."
  echo "If this is a false positive, use: git commit --no-verify"
  exit 1
fi

exit 0

{
  "name": "token-tach",
  "version": "0.0.1",
  "description": "AI coding tool spend monitor \u2014 burn rate and cost tachometer for your menubar.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fmt:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "fmt:rust:check": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:rust": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "preflight": "pnpm typecheck && pnpm test && pnpm fmt:rust:check && pnpm lint:rust && pnpm test:rust"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5",
    "jsdom": "^26",
    "svelte-check": "^4",
    "typescript": "~5.7",
    "vite": "^6",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}